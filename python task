
# OPERATORS 

# 1. Arithmetic Operators
a = int(input("Enter a: "))
b = int(input("Enter b: "))

print("Addition:", a + b)
print("Subtraction:", a - b)
print("Multiplication:", a * b)
print("Division:", a / b)
print("Modulus:", a % b)
print("Floor Division:", a // b)
print("Exponentiation:", a ** b)


# 2. Find Last Digit
num = int(input("Enter a number: "))
print("Last digit:", num % 10)


# 3. Remove Last Digit
num = int(input("Enter a 3-digit number: "))
print("After removing last digit:", num // 10)


# 4. Rectangle Area and Perimeter
length = int(input("Enter length: "))
breadth = int(input("Enter breadth: "))

print("Area:", length * breadth)
print("Perimeter:", 2 * (length + breadth))


# 5. Comparison Operators
a = int(input("Enter a: "))
b = int(input("Enter b: "))

print("a is greater:", a > b)
print("a is smaller:", a < b)
print("Both are equal:", a == b)


# 6. Mark Greater Than or Equal to 50
mark = int(input("Enter mark: "))
print("Pass:", mark >= 50)


# 7. Voting Eligibility AND Valid ID
age = int(input("Enter age: "))
id_status = input("Do you have valid ID? ")

print(age >= 18 and id_status == "yes")


# 8. At Least One Number Greater Than 100
a = int(input("Enter a: "))
b = int(input("Enter b: "))

print(a > 100 or b > 100)


# 9. Username and Password
username = input("Enter username: ")
password = input("Enter password: ")

print(username == "admin" and password == "1234")


