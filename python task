print("Mango" in fruits)


# 13. Character in String
text = input("Enter a string: ")
character = input("Enter a character: ")

print(character in text)


# 14. Identity Operator - Same List
list1 = [10, 20, 30]
list2 = list1

print(list1 is list2)


# 15. == and is
list1 = [10, 20, 30]
list2 = [10, 20, 30]

print(list1 == list2)
print(list1 is list2)


# 16. Bitwise AND, OR, XOR
a = int(input("Enter a: "))
b = int(input("Enter b: "))

print("AND:", a & b)
print("OR:", a | b)
print("XOR:", a ^ b)


# 17. Bitwise NOT
num = int(input("Enter a number: "))
print("NOT:", ~num)


# 18. Bitwise AND and OR
a = int(input("Enter a: "))
b = int(input("Enter b: "))

print("Bitwise AND:", a & b)
print("Bitwise OR:", a | b)


# IF-ELSE 

# 19. Even or Odd
num = int(input("Enter a number: "))

if num % 2 == 0:
    print("Even")
else:
    print("Odd")


# 20. Positive, Negative or Zero
