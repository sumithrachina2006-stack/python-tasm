#single inheritance
class trainer:
    def fun1(self):
        print("hii")
class Gopika(trainer):
    def fun2(self):
        print("Gopika inherit hii")
t=trainer()
g=Gopika()
t.fun1()
g.fun1()
g.fun2()

#hiearichal inheritance
class trainer:
    def fun1(self):
        print("shiny")
class joy(trainer):
    def fun2(self):
        print("joy")
class Gowsik(trainer):
    def fun3(self):
        print("gowsik")
t=trainer()
j=joy()
g=Gowsik()
t.fun1()
j.fun1()
j.fun2()
g.fun1()
g.fun3()

# multi level

