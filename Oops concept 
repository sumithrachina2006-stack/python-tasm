#multiple inheritance

class python:
    def fun1(self):
        print("python")
class EH:
    def fun2(self):
        print("EH")
class Gopika(python,EH):
    def fun3(self):
        print("both")

p=python()
e=EH()
g=Gopika()
p.fun1()
e.fun2()
