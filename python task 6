#SET OPERATIONS

#find the union of two sets
x={1,2,3,4}
y={3,4,5,6}
print(x.union(y))
#intersection
x={1,2,3,4}
y={3,4,5,6}
print(x.intersection(y))
#diffrence
x={1,2,3,4}
y={3,4,5,6}
print(x.difference(y))
# symmetric difference
x={1,2,3,4}
y={3,4,5,6}
print(x.symmetric_difference(y))
#checking subset
x={1,2,3,4}
y={3,4,5,6}
print(x.issubset(y))
#checking disjoint
x={1,2,3,4}
y={3,4,5,6}
print(x.isdisjoint(y))
#convert a list to set to remove duplicates
numbers=[2,4,1,3,4,2]
print(set(numbers))

